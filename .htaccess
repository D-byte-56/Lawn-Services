# ============================================================================
#  EV Lawncare GA Inc — configuración para Apache (SiteGround)
#  Cabeceras de seguridad, HTTPS, compresión y caché. Ver DESPLIEGUE.md.
#  (GitHub Pages ignora este archivo; solo aplica en SiteGround.)
# ============================================================================

# ---- Forzar HTTPS ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Opcional: forzar SIN www (descomenta si el dominio principal es sin www)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Cabeceras de seguridad ------------------------------------------------
<IfModule mod_headers.c>
  # Solo permite recursos de sitios conocidos (fuentes de Google, mapa de Google,
  # widget de reseñas Featurable, envío del formulario a Formspree).
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://featurable.com; frame-src https://www.google.com https://maps.google.com https://featurable.com; connect-src 'self' https://formspree.io https://featurable.com; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  # Evita que el navegador "adivine" el tipo de archivo (previene algunos ataques).
  Header always set X-Content-Type-Options "nosniff"
  # Cuánta info de referencia se manda a otros sitios: solo el dominio, no la ruta.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Obliga a usar HTTPS durante 1 año (activar solo cuando el HTTPS ya funcione bien).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Impide que otros sitios metan tu página dentro de un iframe (anti-clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Apaga funciones del navegador que este sitio no usa.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- No servir archivos internos por la web --------------------------------
<FilesMatch "\.(md|py|zip|htaccess)$">
  Require all denied
</FilesMatch>

# ---- Compresión (páginas más livianas) -------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/xml
</IfModule>

# ---- Caché del navegador (velocidad en visitas repetidas) ------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
